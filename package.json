{
  "name": "civitas-relay-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Civitas Relay HackPrinceton development workspace",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "dev:relay": "npm run build --workspace @civitas/contracts && npm run dev --workspace @civitas/relay",
    "build:relay": "npm run build --workspace @civitas/contracts && npm run build --workspace @civitas/relay",
    "start:relay": "npm run start --workspace @civitas/relay",
    "setup:demo": "node apps/relay/scripts/setup-demo.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
