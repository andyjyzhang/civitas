# Local-only PostgreSQL credentials. Compose reads these now.
POSTGRES_USER=civitas
POSTGRES_PASSWORD=civitas_local_only
POSTGRES_DB=civitas
POSTGRES_PORT=5432

# Relay reads root .env. Explicit memory mode keeps the local demo runnable.
# Set RELAY_STORAGE=postgres and run npm run db:migrate to persist data.
# If RELAY_STORAGE is omitted, DATABASE_URL selects postgres automatically.
RELAY_STORAGE=memory
# Keep DATABASE_URL in sync if you change the local database settings above.
DATABASE_URL=postgresql://civitas:civitas_local_only@127.0.0.1:5432/civitas
RELAY_HOST=127.0.0.1
RELAY_PORT=4000
CIVITAS_DEMO_SPACE_ID=sp_demo
# Generate these privately with npm run setup:demo; do not use example tokens.
CIVITAS_PUBLISHER_TOKEN=
CIVITAS_RECEIVER_TOKEN=
WEB_ORIGIN=http://localhost:3000
# Public URL only; never put credentials in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_RELAY_URL=http://localhost:4000

# Shared prize demo: replace DATABASE_URL in private deployment config with
# the Tiger Cloud TLS connection URI. Never expose it through NEXT_PUBLIC_.
# Set true for Timescale; db:migrate then also applies 002_timescale.sql.
# Startup fails if the enabled analytics hypertable is missing.
# Remote PostgreSQL uses verified TLS. Optional CA bundle path:
DATABASE_CA_FILE=
RELAY_ANALYTICS_ENABLED=false
# Analyst: set OPENAI_API_KEY or ANTHROPIC_API_KEY privately in .local/model.env.
# Optional CIVITAS_MODEL_PROVIDER=openai|anthropic and CIVITAS_MODEL select a model.
# Desktop uses CIVITAS_RELAY_URL (defaults to loopback relay) and WEB_ORIGIN.
# Local password accounts persist with PostgreSQL; email verification/recovery are
# not implemented. Do not expose this loopback hackathon server publicly.
# Agent tokens belong in a user credential store outside this repository.
